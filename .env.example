# 仅在线生成需要；不配置时自动使用可审计的离线抽取式生成器
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# PubMed 可不填；填写后限流额度更高
PUBMED_API_KEY=
NCBI_EMAIL=

# 实时检索：PubMed、Europe PMC、ClinicalTrials.gov API v2
ENABLE_LIVE_APIS=true
FILTER_PREPRINT=true
API_REQUEST_TIMEOUT=12
API_RATE_LIMIT_SECONDS=0.35
API_MAX_ATTEMPTS=3
LIVE_CACHE_TTL_SECONDS=3600
TOP_K=8
PRE_REFUSAL_THRESHOLD=0.18
POST_FAILURE_THRESHOLD=0.5

# Supabase 云端证据库。publishable key 仅用于只读检索；secret key 只供同步脚本，
# 会绕过 RLS，严禁提交到 Git、写入浏览器代码或分享给客户端。
ENABLE_SUPABASE=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_backend_only_key
SUPABASE_TIMEOUT=15

# 可选：先从 Supabase 拉取 JSON，再把它作为完全离线的快照使用。
# LOCAL_CORPUS_PATH=data/raw/supabase_corpus.json

# 可选：MCP/已安装包挂载仓库外的数据、PDF 索引和可写缓存目录。
# EVIDENCE_ASSISTANT_DATA_DIR=/absolute/path/to/data
# EVIDENCE_ASSISTANT_CACHE_DIR=/absolute/path/to/cache
# PDF_INDEX_PATH=/absolute/path/to/pdf_collection.sqlite3

# 阶段 2 可选模型后端。默认 legacy/deterministic 不加载或下载模型。
RETRIEVAL_BACKEND=legacy
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=main
VECTOR_INDEX_PATH=data/indexes
RERANK_BACKEND=deterministic
RERANK_MODEL=
RERANK_MODEL_REVISION=main
MODEL_LOCAL_FILES_ONLY=true
RETRIEVE_K=40
LEXICAL_RETRIEVE_K=30
DENSE_RETRIEVE_K=30
RERANK_K=8
GENERATION_K=5
RRF_K=60
EMBEDDING_BATCH_SIZE=16
RERANK_BATCH_SIZE=16
