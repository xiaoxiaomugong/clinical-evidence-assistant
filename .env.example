# 仅在线生成需要；不配置时自动使用可审计的离线抽取式生成器
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# PubMed 可不填；填写后限流额度更高
PUBMED_API_KEY=
NCBI_EMAIL=

# 实时检索：PubMed、Europe PMC、ClinicalTrials.gov API v2
ENABLE_LIVE_APIS=true
FILTER_PREPRINT=true
API_REQUEST_TIMEOUT=12
API_RATE_LIMIT_SECONDS=0.35
API_MAX_ATTEMPTS=3
LIVE_CACHE_TTL_SECONDS=3600
TOP_K=8
PRE_REFUSAL_THRESHOLD=0.18
POST_FAILURE_THRESHOLD=0.5

# 阶段 2 可选模型后端。默认 legacy/deterministic 不加载或下载模型。
RETRIEVAL_BACKEND=legacy
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=main
VECTOR_INDEX_PATH=data/indexes
RERANK_BACKEND=deterministic
RERANK_MODEL=
RERANK_MODEL_REVISION=main
MODEL_LOCAL_FILES_ONLY=true
RETRIEVE_K=40
LEXICAL_RETRIEVE_K=30
DENSE_RETRIEVE_K=30
RERANK_K=8
GENERATION_K=5
RRF_K=60
EMBEDDING_BATCH_SIZE=16
RERANK_BATCH_SIZE=16
