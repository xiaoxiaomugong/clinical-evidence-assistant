# Send only application sources and public corpus files to Docker builds.
**
!pyproject.toml
!README.md
!LICENSE
!app.py
!src/
!src/**
!frontend/
!frontend/**
!data/
!data/corpus_version.json
!data/knowledge_pages/
!data/knowledge_pages/*.json
!data/raw/
!data/raw/local_corpus.json
!deploy/
!deploy/*.Dockerfile
!deploy/web.conf
!deploy/requirements-web.lock

**/.env*
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
